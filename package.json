{
  "name": "wrongway",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:contract": "node --test tests/normal-duel-contract.test.mjs",
    "check:normal-duel-trajectories": "node scripts/generate-normal-duel-trajectories.mjs --check",
    "check:normal-duel-perft": "node scripts/generate-normal-duel-perft.mjs --check",
    "check:normal-duel-corpora": "npm run check:normal-duel-trajectories && npm run check:normal-duel-perft",
    "check:normal-duel-throughput-benchmark": "node scripts/run-normal-duel-throughput-benchmark.mjs --smoke",
    "build:normal-duel-wasm": "node scripts/build-normal-duel-wasm.mjs",
    "check:normal-duel-wasm": "npm run build:normal-duel-wasm && node scripts/check-normal-duel-wasm.mjs",
    "build:normal-duel-wasm-candidate": "node scripts/build-normal-duel-wasm-candidate.mjs",
    "check:normal-duel-wasm-candidate": "npm run build:normal-duel-wasm-candidate && node scripts/check-normal-duel-wasm-candidate.mjs",
    "benchmark:normal-duel-throughput": "node scripts/run-normal-duel-throughput-benchmark.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
